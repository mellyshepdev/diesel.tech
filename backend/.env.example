# Copy to .env and fill in values
DATABASE_URL=postgres://diesel_app:changeme@localhost:5432/diesel_tech
PORT=4000

# Keycloak (blacksheep realm) — used to validate bearer tokens.
# login.theofficialblacksheepco.com doesn't resolve; the realm actually lives
# at bsco-keycloak.fly.dev (see ~/projects/keycloak/fly.toml).
KEYCLOAK_URL=https://bsco-keycloak.fly.dev
KEYCLOAK_REALM=blacksheep
KEYCLOAK_CLIENT_ID=diesel-tech-frontend

# Comma-separated list of allowed frontend origins. localhost for dev; the
# GitLab Pages URL is the deployed engine-viewer (see docs/reference/
# repo-diesel-tech memory note / .gitlab-ci.yml create-pages job).
CORS_ORIGIN=http://localhost:5173,https://gbonds1.gitlab.io
