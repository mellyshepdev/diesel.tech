# Copy to .env and fill in values
DATABASE_URL=postgres://diesel_app:changeme@localhost:5432/diesel_tech
PORT=4000

# Keycloak (blacksheep realm) — used to validate bearer tokens
KEYCLOAK_URL=https://login.theofficialblacksheepco.com
KEYCLOAK_REALM=blacksheep
KEYCLOAK_CLIENT_ID=diesel-tech-frontend

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://tech.theofficialblacksheepco.com
